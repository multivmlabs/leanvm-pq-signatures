+    /// Prepare the selected verifier row using trusted immutable public NTT data.
+    ///
+    /// The artifact decoder checks setup and schedule identities, dimensions,
+    /// lengths and residue ranges. It does not prove that the transformed
+    /// matrix was derived correctly. Callers must authenticate the exact bytes
+    /// as public verification-key data, for example by embedding a validated
+    /// export in the trusted guest ELF. Never pass unauthenticated prover advice.
+    #[doc(hidden)]
+    pub fn from_derived_setup_with_trusted_cache(
+        records: usize,
+        setup: AkitaVerifierSetup<BaseField>,
+        artifact: &[u8],
+    ) -> Result<Self, Error> {
+        let (_, _, selection) = verifier_group_profiles_of(P::DEGREE_ID, records)?;
+        Ok(Self {
+            records,
+            akita: AkitaVerifier::<Width4Config>::for_selection(
+                setup,
+                Width4Config::catalog()?.clone(),
+                selection,
